# ============================================================
# J-Gate Environment Variables Configuration
# ============================================================

# Target admin email where brochure leads and inquiries are delivered
ADMIN_EMAIL="contact@indobox.co.jp"

# ------------------------------------------------------------
# Option A: Resend API (Recommended for Vercel / Cloud — 100% Free & Fast)
# Get a free key at: https://resend.com
# ------------------------------------------------------------
# RESEND_API_KEY="re_123456789"
# SMTP_FROM="J-Gate <onboarding@resend.dev>"

# ------------------------------------------------------------
# Option B: Standard SMTP (Gmail, Google Workspace, AWS SES, Brevo, SendGrid)
# ------------------------------------------------------------
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="your-email@indobox.co.jp"
# SMTP_PASS="your-app-password"
# SMTP_SECURE="false"
# SMTP_FROM="\"J-Gate\" <contact@indobox.co.jp>"

# ------------------------------------------------------------
# Option C: Webhook forwarding (Optional for Slack, Discord, Zapier)
# ------------------------------------------------------------
# LEAD_WEBHOOK_URL="https://hooks.slack.com/services/..."

# ------------------------------------------------------------
# Database (SQLite default or PostgreSQL / Supabase / Neon)
# ------------------------------------------------------------
DATABASE_URL="file:./dev.db"

# Admin API security token for accessing /api/admin/leads
ADMIN_SECRET_TOKEN="jgate_secure_admin_2026"
